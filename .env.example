# PostgreSQL (docker compose maps host 5433 → container 5432)
DATABASE_URL="postgresql://lifebudget:lifebudget@localhost:5433/lifebudget?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-32-character-or-longer-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: set to "true" to allow the public demo login buttons
NEXT_PUBLIC_DEMO_MODE="true"
